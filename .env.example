# ==========================================
# Zenith Store - Razorpay Configuration
# ==========================================

# 1. Sign up on https://dashboard.razorpay.com
# 2. Go to Settings -> API Keys -> Generate Key
# 3. Paste your public Key ID below (starts with 'rzp_test_' for sandbox or 'rzp_live_' for production)
# IMPORTANT: Never commit your Key Secret to client-side code! Only Key ID is public.

VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE

